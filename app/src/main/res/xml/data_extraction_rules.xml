<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ (API 31+).
   Exclude auth session and user cache from cloud backup and device transfer
   to prevent stale/invalid sessions from being restored after reinstall.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude auth-related SharedPreferences from cloud backup -->
        <exclude domain="sharedpref" path="supa_auth_session.xml"/>
        <exclude domain="sharedpref" path="remusic_user_cache.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Also exclude from device-to-device transfer -->
        <exclude domain="sharedpref" path="supa_auth_session.xml"/>
        <exclude domain="sharedpref" path="remusic_user_cache.xml"/>
    </device-transfer>
</data-extraction-rules>