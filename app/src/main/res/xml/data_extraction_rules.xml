<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for Android 12+ (API 31+).
   Exclude auth session and user cache from cloud backup and device transfer
   to prevent stale/invalid sessions from being restored after reinstall.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all SharedPreferences from cloud backup -->
        <exclude domain="sharedpref" path="."/>
        <!-- Exclude DataStore settings -->
        <exclude domain="file" path="datastore"/>
        <!-- Exclude Room Database -->
        <exclude domain="database" path="music_database.db"/>
        <exclude domain="database" path="music_database.db-shm"/>
        <exclude domain="database" path="music_database.db-wal"/>
    </cloud-backup>
    <device-transfer>
        <!-- Also exclude from device-to-device transfer -->
        <exclude domain="sharedpref" path="."/>
        <exclude domain="file" path="datastore"/>
        <!-- Exclude Room Database -->
        <exclude domain="database" path="music_database.db"/>
        <exclude domain="database" path="music_database.db-shm"/>
        <exclude domain="database" path="music_database.db-wal"/>
    </device-transfer>
</data-extraction-rules>