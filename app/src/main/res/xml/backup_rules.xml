<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and below (pre-API 31).
   Exclude auth session and user cache from auto-backup
   to prevent stale/invalid sessions from being restored after reinstall.
-->
<full-backup-content>
    <!-- Exclude auth-related and all SharedPreferences from backup -->
    <exclude domain="sharedpref" path="."/>
    
    <!-- Exclude DataStore settings to prevent queue/state restoration -->
    <exclude domain="file" path="datastore"/>
    
    <!-- Exclude Room Database -->
    <exclude domain="database" path="music_database.db"/>
    <exclude domain="database" path="music_database.db-shm"/>
    <exclude domain="database" path="music_database.db-wal"/>
</full-backup-content>