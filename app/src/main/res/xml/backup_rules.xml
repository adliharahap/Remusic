<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and below (pre-API 31).
   Exclude auth session and user cache from auto-backup
   to prevent stale/invalid sessions from being restored after reinstall.
-->
<full-backup-content>
    <!-- Exclude auth-related SharedPreferences from backup -->
    <exclude domain="sharedpref" path="supa_auth_session.xml"/>
    <exclude domain="sharedpref" path="remusic_user_cache.xml"/>
</full-backup-content>